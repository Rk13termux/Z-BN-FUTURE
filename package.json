{
  "name": "binance-futures-trading-app",
  "version": "1.0.0",
  "description": "Professional Binance Futures Trading Analysis App",
  "main": "src/main.js",
  "scripts": {
    "start": "electron . --disable-gpu",
    "dev": "electron . --disable-gpu",
    "build": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "keywords": [
    "binance",
    "futures",
    "trading",
    "crypto",
    "electron"
  ],
  "author": "Trading Bot",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "chalk": "^4.1.2",
    "chart.js": "^4.4.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-chart-financial": "^0.2.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.3.1",
    "lightweight-charts": "^5.2.0",
    "technicalindicators": "^3.1.0"
  },
  "build": {
    "appId": "com.trading.binance-futures-bot",
    "productName": "Binance Futures Bot",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    }
  }
}
